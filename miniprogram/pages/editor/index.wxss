/* Photo-first workspace. Canvas and controls occupy separate layout regions. */
.workspace{height:100vh;display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}
.toolbar{width:100%;height:52px;flex:0 0 52px;display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;padding:8px 12px;border-bottom:1px solid var(--border)}
.toolbar .toolbar-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;max-width:none;height:36px;min-height:36px;margin:0;padding:0;font-size:13px;line-height:1;white-space:nowrap;word-break:keep-all;border-radius:8px}
.toolbar .toolbar-choose{width:84px;flex:0 0 84px;background:transparent;border:1px solid var(--border-strong)}
.toolbar .export-group{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex:0 0 172px;width:172px;min-width:172px;margin-left:auto}
.toolbar .toolbar-format{display:block;width:60px;flex:0 0 60px;min-width:60px}
.toolbar .format{width:60px;height:36px;display:flex;align-items:center;justify-content:center;padding:0;font-size:12px;color:var(--text-2);white-space:nowrap}
.toolbar .toolbar-save{width:104px;flex:0 0 104px;border:0}
.stage{position:relative;display:flex;flex-direction:column;flex:none;width:100%;background:var(--stage);overflow:hidden}
.preview-surface{position:relative;flex:1;min-height:0;width:100%;overflow:hidden;background:radial-gradient(80% 60% at 50% 42%,#1e281a 0%,var(--stage) 78%)}
.preview{position:absolute;top:0;left:0;width:100%;height:100%}.canvas-idle{left:-10000px}
.empty{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:24px;text-align:center}
.empty-title{font-size:21px;font-weight:500;letter-spacing:1px;color:var(--text)}.empty>text{font-size:13px;color:var(--text-3)}.empty button{margin-top:8px;padding:10px 24px;min-height:42px}
.stage-footer{height:44px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:5px 14px;gap:8px;background:var(--stage);border-top:1px solid var(--border)}
.view-actions,.image-actions{display:flex;align-items:center;gap:8px;flex:none}
.stage-footer button{width:auto;flex:none;min-height:30px;padding:5px 8px;font-size:12px;background:transparent;color:var(--text-2)}
.stage-footer button[disabled]{background:transparent!important;color:var(--text-3)!important}
.image-actions{gap:4px}
/* One shared control surface, with consistent alignment and emphasis. */
.dock{flex:1;min-height:0;display:flex;flex-direction:column;background:var(--surface);border-top:1px solid var(--border);padding-bottom:env(safe-area-inset-bottom)}
.tabs{display:flex;flex:none;gap:0;height:46px;padding:0 16px;border-bottom:1px solid var(--border)}
.tabs button{flex:1;width:0;min-width:0;margin:0;padding:11px 5px;min-height:44px;border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--text-2);font-size:14px;font-weight:500}
.tabs .active{color:var(--accent);border-bottom-color:var(--accent)}
.panel{height:0;min-height:0;flex:1}.panel-inner{padding:12px 16px}

.parameter-list{width:100%;white-space:nowrap;margin-bottom:8px}.parameter-row{display:inline-block;white-space:nowrap;padding-bottom:4px}
.parameter-row button{display:inline-block;vertical-align:middle;flex:none;width:auto;min-width:0;margin:0 6px 0 0;border:1px solid transparent;border-radius:8px;background:transparent;color:var(--text-2);font-size:12px;line-height:20px;font-weight:400;white-space:nowrap}
.parameter-row button:last-child{margin-right:0}.parameter-row.color-parameters{display:flex;width:100%}.color-parameters button{flex:0 0 calc(18.181818% - 5.454545px);width:calc(18.181818% - 5.454545px);min-width:0;min-height:52px;padding:3px 2px 4px;text-align:center}.parameter-icon{display:block;font-size:20px;line-height:24px;margin-bottom:3px}
.frame-parameters button{min-height:34px;padding:6px 10px;line-height:20px}.parameter-row .chosen{border-color:var(--accent-line)!important;background:var(--grad-chosen)!important;color:var(--accent)!important}
.value{font-size:15px;color:var(--accent);font-variant-numeric:tabular-nums}
.slider{height:42px;padding:18px 10px;touch-action:pan-y}.slider.disabled{opacity:.4}.track{position:relative;height:4px;background:var(--border-strong);border-radius:4px}.track-fill{height:4px;background:linear-gradient(90deg,var(--accent-2) 0%,var(--accent-3) 100%);border-radius:4px}.thumb{position:absolute;top:50%;width:20px;height:20px;border-radius:50%;background:var(--accent);transform:translate(-50%,-50%)}
.caption{display:flex;flex-direction:row;align-items:center;gap:10px;margin-top:7px;color:var(--text-2);font-size:12px}.caption>text{flex:none;white-space:nowrap}.caption input{flex:1;min-width:0;height:38px;line-height:38px;padding:0 10px;background:var(--input);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:14px}
.status{font-size:12px;color:var(--text-3);line-height:1.6;margin-top:8px}
/* History is a compact list, with one fixed-width mark action per row. */
.history-actions{display:flex;gap:8px;margin-bottom:12px}.history-actions button{flex:1;width:0;min-width:0;font-size:12px;height:36px;padding:7px 5px;border:0;background:var(--raised)}
.history-row{display:flex;align-items:stretch;margin-bottom:8px;border:1px solid var(--border);border-radius:8px;background:var(--raised);overflow:hidden}
.history-step{display:flex;flex:1;width:0;min-width:0;align-items:center;justify-content:space-between;gap:8px;padding:8px 12px;min-height:52px;text-align:left;background:transparent;border-radius:0}.history-step.chosen{box-shadow:inset 3px 0 var(--accent)}.step-copy{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}.step-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;line-height:20px}.step-meta{font-size:11px;line-height:16px;color:var(--text-3)}.current-badge{flex:none;font-size:10px;line-height:18px;padding:0 5px;border-radius:4px;background:var(--accent-soft);color:var(--accent)}
.history-row .star{display:flex;align-items:center;justify-content:center;flex:0 0 40px;width:40px;min-width:40px;margin:0;padding:0;background:transparent;border-left:1px solid var(--border);border-radius:0;color:var(--text-3);font-size:20px}.history-row .star.marked{color:var(--accent);background:var(--accent-soft)}
.export-canvas{position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;pointer-events:none}
.privacy-mask{position:fixed;z-index:100;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.78);display:flex;align-items:center;justify-content:center;padding:24px}.privacy-card{width:100%;max-width:420px;padding:24px;background:var(--surface);border:1px solid var(--border);border-radius:12px;font-size:14px;line-height:1.8}.privacy-card .empty-title{margin-bottom:14px}.privacy-link{color:var(--accent);background:transparent;margin:12px 0;white-space:normal}.privacy-actions{display:flex;gap:8px}.privacy-actions button{flex:1;width:0;padding:8px 6px}
@media(max-width:340px){.toolbar,.stage-footer{padding-left:10px;padding-right:10px}.export-group{gap:4px}.toolbar>button{padding-left:9px;padding-right:9px}.export-group button{padding-left:10px;padding-right:10px}.stage-footer button{padding-left:5px;padding-right:5px}.view-actions{gap:3px}.panel-inner{padding-left:12px;padding-right:12px}.tabs{padding-left:12px;padding-right:12px;gap:10px}}

.slider-row{display:flex;align-items:center;gap:12px;margin-top:8px}.slider-row .slider{flex:1;min-width:0}.slider-row .value{flex:0 0 36px;width:36px;min-width:36px;text-align:right;font-size:14px;font-variant-numeric:tabular-nums}

@media(max-width:340px){.toolbar{padding-left:10px;padding-right:10px}.toolbar .toolbar-choose{width:76px;flex-basis:76px}.toolbar .toolbar-button{padding:0}.toolbar .export-group{margin-left:auto}}
/* The five frame parameters share the available row equally. */
.parameter-row.frame-parameters{display:flex;width:100%;box-sizing:border-box;gap:4px;padding:0 0 4px}
.parameter-row.frame-parameters button{display:block;flex:1 1 0%;width:0;min-width:0;max-width:none;margin:0;padding:6px 2px;text-align:center;box-sizing:border-box;white-space:nowrap;font-size:12px}

/* Keep all frame controls visible; the dock alone owns the bottom safe area. */
.frame-panel{display:flex;flex-direction:column;gap:8px;padding-top:10px;padding-bottom:10px}
.frame-panel .frame-list{display:block;height:38px;flex:none;margin:0}
.frame-panel .frame-parameters{padding-bottom:0}
.frame-panel .slider-row{height:42px;flex:none;margin:0}
.frame-panel .caption{height:38px;flex:none;margin:0}

/* Explicit color height prevents the native scroll viewport retaining the frame row height. */
.color-list{display:block;height:60px;min-height:60px;flex:none}

/* Three compact preset sections; saved presets never wrap to a second row. */
.preset-panel{padding-top:10px;padding-bottom:6px}
.preset-section{display:flex;align-items:center;gap:12px;margin-bottom:10px;min-width:0}
.preset-heading{flex:0 0 52px;width:52px;font-size:12px;color:var(--text-2);white-space:nowrap}
.recommended-scroll{flex:1;width:0;min-width:0;height:36px;white-space:nowrap}.recommended-strip{display:flex;gap:8px;width:100%;height:36px}.recommended-strip button{flex:0 0 calc(28.5714% - 5px);width:calc(28.5714% - 5px);min-width:0;height:36px;padding:7px 2px;font-size:12px;background:var(--raised);border:1px solid transparent;border-radius:8px}

.saved-scroll{flex:1;width:0;min-width:0;height:54px;white-space:nowrap}.saved-strip{display:flex;gap:8px;width:100%;height:48px}
.saved-card{display:flex;align-items:center;flex:0 0 128px;width:128px;min-width:0;background:var(--raised);border:1px solid var(--border);border-radius:8px;overflow:hidden}
.saved-card .saved-main{display:flex;align-items:center;justify-content:center;flex:1;width:0;min-width:0;background:transparent;text-align:center;padding:5px 7px}.saved-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px}.saved-card .saved-more{flex:none;width:28px;padding:0;line-height:42px;background:transparent;font-size:12px}
.preset-empty{display:flex;align-items:center;flex:1;min-width:0;height:54px;color:var(--text-3);font-size:11px}
.preset-actions{display:flex;gap:8px}.preset-actions button{display:flex;align-items:center;justify-content:center;line-height:1;flex:1;width:0;min-width:0;height:36px;padding:7px 8px;font-size:12px}
.adjust-panel{padding-top:16px}.adjust-panel .slider-row{margin-top:12px}.caption>text{width:52px}.stage-footer{border-top:1px solid var(--border)}.tabs button[disabled]{background:transparent!important}

.saved-card.selected-preset{border-color:var(--accent-line);background:var(--grad-chosen)}.selected-preset .saved-name{color:var(--accent)}

.stage-footer .compare-button.comparing{color:var(--accent);background:var(--accent-soft)}

/* Give the photo more of the viewport and tighten the supporting controls. */
.toolbar{height:44px;flex-basis:44px;padding:5px 10px}
.toolbar .toolbar-button{height:32px;min-height:32px;line-height:1;font-size:12px;border-radius:8px}
.toolbar .toolbar-format,.toolbar .format{height:32px;font-size:11px}
.stage-footer{height:36px;padding:3px 10px;gap:5px}
.stage-footer button{min-height:28px;padding:4px 6px;font-size:11px}
.view-actions,.image-actions{gap:4px}
.tabs{height:40px;padding:0 12px}
.tabs button{min-height:38px;padding:8px 4px;font-size:13px}
.panel-inner{padding:9px 12px}
.frame-panel{gap:5px;padding-top:7px;padding-bottom:7px}
.frame-panel .frame-list{height:32px}
.parameter-row.frame-parameters button{min-height:30px;padding:4px 1px;font-size:11px}
.frame-panel .slider-row{height:36px}
.slider{height:36px;padding:15px 9px}
.thumb{width:18px;height:18px}
.slider-row{gap:8px;margin-top:5px}
.slider-row .value{font-size:13px}
.frame-panel .caption{height:32px}
.caption{gap:8px;font-size:11px}
.caption input{height:32px;line-height:30px;padding:0 8px;font-size:13px}
.color-list{height:52px;min-height:52px;margin-bottom:5px}
.color-parameters button{min-height:46px;padding:2px 1px 3px;font-size:11px}
.parameter-icon{font-size:17px;line-height:20px;margin-bottom:2px}
.adjust-panel{padding-top:10px;min-height:100%;display:flex;flex-direction:column;justify-content:center;box-sizing:border-box}
.adjust-panel .slider-row{margin-top:7px}
.preset-panel{padding-top:7px;padding-bottom:4px}
.preset-section{gap:8px;margin-bottom:6px}
.preset-heading{flex-basis:46px;width:46px;font-size:11px}
.recommended-scroll{height:32px}
.recommended-strip{gap:6px;height:32px}
.recommended-strip button{flex:0 0 calc(28.5714% - 4px);width:calc(28.5714% - 4px);height:32px;padding:5px 2px;font-size:11px}
.saved-scroll{height:38px}
.saved-strip{height:32px;gap:6px}
.saved-card{height:32px;flex:0 0 calc(28.5714% - 4px);width:calc(28.5714% - 4px);box-sizing:border-box;background:var(--raised);border:1px solid var(--border);border-radius:8px}
.saved-card .saved-main{padding:4px 6px}
.saved-name{font-size:11px}
.saved-card .saved-more{width:24px;line-height:36px;font-size:11px}
.preset-empty{height:42px;font-size:10px}
.preset-actions{gap:6px}
.preset-actions button{height:32px;padding:5px 6px;font-size:11px}
.history-actions{gap:6px;margin-bottom:8px}
.history-actions button{height:30px;font-size:11px;padding:5px 3px}
.history-row{margin-bottom:6px}
.history-step{min-height:44px;padding:6px 9px;gap:6px}
.step-title{font-size:12px;line-height:17px}
.step-meta{font-size:10px;line-height:14px}
.history-row .star{flex-basis:34px;width:34px;min-width:34px;font-size:17px}
.history-list{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 0}
.history-list .history-row{width:calc(50% - 3px);min-height:48px;margin:0}
.history-list .history-step{min-height:48px;padding:5px 5px;gap:3px}
.history-list .step-title{font-size:11px;line-height:15px}
.history-list .step-meta{font-size:9px;line-height:12px}
.history-list .current-badge{font-size:9px;line-height:15px;padding:0 4px}
.history-list .star{flex-basis:28px;width:28px;min-width:28px;font-size:15px}
.status{font-size:10px;margin-top:6px}
.empty-title{font-size:18px}
.empty{gap:10px;padding:18px}
.empty>text{font-size:12px}
.empty button{min-height:36px;padding:8px 20px}
.tabs button{display:flex;align-items:center;justify-content:center;gap:5px}
.saved-card .saved-main,.saved-card .saved-main[disabled]{height:100%;min-height:0;margin:0;border:0;border-radius:0;background:transparent!important;color:var(--text);box-shadow:none}
.saved-card .saved-main[disabled]{color:var(--text-2)!important}
.saved-card .saved-more{flex:0 0 28px;width:28px;height:100%;padding:0;border:0;border-left:1px solid var(--border);border-radius:0;background:transparent!important;box-shadow:none;display:flex;align-items:center;justify-content:center;line-height:1;font-size:12px}
.frame-tab-switch{position:relative;display:block;flex:none;width:22px;height:12px;border-radius:8px;background:var(--border-strong);transition:background .15s ease}
.frame-tab-switch.on{background:linear-gradient(180deg,var(--accent-3) 0%,var(--accent-2) 100%)}
.frame-tab-switch.disabled{opacity:.4}
.frame-tab-knob{position:absolute;top:2px;left:2px;width:8px;height:8px;border-radius:50%;background:var(--text-2);transition:left .15s ease,background .15s ease}
.frame-tab-switch.on .frame-tab-knob{left:12px;background:var(--accent-ink)}
