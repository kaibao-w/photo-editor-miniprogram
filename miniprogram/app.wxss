page{height:100%;background:#111412;color:#eef2eb;font-family:system-ui,-apple-system,sans-serif;font-size:14px}view,button,input{box-sizing:border-box}button{font-size:13px;line-height:1.4;padding:8px 10px;margin:0;border-radius:7px;color:#eef2eb;background:#252c26;min-height:34px}button::after{border:none}button[disabled]{color:#758076;background:#202622}.primary{background:#c9ee8a;color:#17200e;font-weight:600}.chosen{background:#303d27!important;color:#c9ee8a!important;border:1px solid #526443!important}text{line-height:1.5}
