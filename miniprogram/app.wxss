/* 微光快调 · 全局主题
   统一色板：单一暗色底 + 黄绿强调；图片舞台更深，突出照片本身。 */
page{
  height:100%;
  background:#0d0f0d;
  color:#eef2eb;
  font-family:system-ui,-apple-system,sans-serif;
  font-size:14px;
  --bg:#0d0f0d;            /* 页面背景 */
  --stage:#050605;         /* 图片舞台（近纯黑） */
  --surface:#161a16;       /* 面板背景 */
  --raised:#1e231e;        /* 按钮 / 卡片 */
  --input:#141814;         /* 输入框 */
  --border:#262c26;        /* 常规边框 */
  --border-strong:#374037; /* 强边框 / 选中描边 */
  --text:#eef2eb;          /* 主文本 */
  --text-2:#a6b0a6;        /* 次级文本 */
  --text-3:#7b887b;        /* 弱文本 / 禁用 */
  --accent:#c9ee8a;        /* 强调色（微光） */
  --accent-ink:#16200f;    /* 强调色上的文字 */
  --accent-soft:rgba(201,238,138,0.13);   /* 通透绿底（选中态） */
  --accent-line:rgba(201,238,138,0.34);   /* 通透绿描边 */
  --grad-chosen:linear-gradient(180deg,rgba(201,238,138,0.20) 0%,rgba(201,238,138,0.08) 100%); /* 选中态质感渐变 */
  --accent-2:#a5d25c;      /* 强调色 · 深端（渐变） */
  --accent-3:#dcf4a4;      /* 强调色 · 亮端（渐变） */
}
view,button,input{box-sizing:border-box}
button{width:auto;min-width:0;margin:0;padding:7px 12px;font-size:13px;font-weight:400;line-height:20px;border-radius:8px;background:var(--raised);color:var(--text);white-space:nowrap;word-break:keep-all}
button::after{border:none}
button[disabled]{background:#181d18!important;color:var(--text-3)!important}
.primary{background:linear-gradient(180deg,var(--accent-3) 0%,var(--accent-2) 100%);color:var(--accent-ink);font-weight:600}
.chosen{background:var(--grad-chosen)!important;color:var(--accent)!important;border-color:var(--accent-line)!important}
text{line-height:1.5}
