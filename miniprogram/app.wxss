page{height:100%;background:#111412;color:#eef2eb;font-family:system-ui,-apple-system,sans-serif;font-size:14px}
view,button,input{box-sizing:border-box}
button{width:auto;min-width:0;margin:0;padding:7px 12px;font-size:13px;font-weight:400;line-height:20px;border-radius:8px;background:#252c26;color:#eef2eb;white-space:nowrap;word-break:keep-all}
button::after{border:none}
button[disabled]{background:#1c221d!important;color:#657163!important}
.primary{background:#c9ee8a;color:#17200e;font-weight:600}
.chosen{background:#2b3524!important;color:#c9ee8a!important;border-color:#526443!important}
text{line-height:1.5}
